@model IEnumerable<FacultyModel>

@{
    ViewData["Title"] = "Danh sách khoa viện";
}

<div>
    <div class="card card-outline card-primary shadow-sm mb-4">
        <div class="card-body py-3 px-4">
            <div class="d-flex align-items-center justify-content-between flex-wrap">

                <div class="d-flex align-items-center">
                    <!-- ICON -->
                    <div class="d-flex align-items-center justify-content-center rounded mr-3"
                         style="width: 52px; height: 52px; background-color: #e8f1ff; flex-shrink: 0;">
                        <i class="fas fa-university text-primary" style="font-size: 24px;"></i>
                    </div>

                    <!-- NỘI DUNG -->
                    <h3 class="font-weight-bold text-dark mb-0" style="font-size: 22px;">
                        Quản lý khoa viện
                    </h3>
                </div>

                <!-- TÌM KIẾM -->
                <form asp-action="Search" method="get" class="d-flex" style="min-width: 380px;">
                    <input type="text" name="searchString" class="form-control mr-2"
                           placeholder="Tìm theo mã hoặc tên khoa viện..."
                           value="@ViewBag.SearchString" />
                    <button type="submit" class="btn btn-primary text-nowrap">Tìm</button>
                </form>

            </div>
        </div>
    </div>

    <!-- NÚT THÊM -->
    <div class="mb-3">
        <a class="btn btn-success" asp-action="Create" asp-controller="Faculty">
            <i class="fas fa-plus mr-1"></i> Thêm khoa viện
        </a>
    </div>
    <div class="col-sm-12" style="margin-left:5px">
        <table class="table table-bordered table-hover" id="myTable">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Mã Khoa-Viện</th>
                    <th>Tên Khoa-Viện</th>    
                    <th>Mô Tả Khoa-Viện</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td width="50">@user.Id</td>
                        <td>@user.FacultyCode</td>
                        <td width="200px">@user.FacultyName</td>
                        <td width="550px">@user.FacultyDescription</td>
                        <td>
                            <a class="btn btn-warning btn-sm" asp-action="Edit" asp-controller="Faculty" asp-route-id="@user.Id">Sửa</a>
                            <form asp-action="Delete" asp-controller="Faculty" asp-route-id="@user.Id" method="post" onsubmit=" return confirm('bạn có chắc chắn xoá khoa-viện này không?')" style="display:inline;">
                                <button type="submit" class="btn btn-danger btn-sm">Xoá</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>