@model List<QuanLyDiemSinhVien.Models.AttendanceSessionModel>
@{
    var sectionId = ViewBag.SectionId;
}

<div style="padding-left:20px;padding-top:20px">
    <div class="card card-outline card-primary shadow-sm mb-4">
        <div class="card-body py-3 px-4">
            <div class="d-flex align-items-center">
                <div class="d-flex align-items-center justify-content-center rounded mr-3"
                     style="width: 52px; height: 52px; background-color: #e8f1ff; flex-shrink: 0;">
                    <i class="fas fa-clipboard-check text-primary" style="font-size: 24px;"></i>
                </div>
                <h3 class="font-weight-bold text-dark mb-0" style="font-size: 22px;">
                    Danh sách buổi điểm danh
                </h3>
            </div>
        </div>
    </div>
    <div class="mb-3">
        <a asp-action="Create" asp-route-sectionId="@sectionId" class="btn btn-success">
            <i class="fas fa-plus mr-1"></i> Tạo buổi điểm danh mới
        </a>
        <a asp-action="ExportOptions" asp-route-sectionId="@sectionId" class="btn btn-warning ml-2">
            <i class="fas fa-file-excel mr-1"></i> Xuất file Excel điểm danh sinh viên
        </a>
    </div>

    <table class="table table-bordered">
        <thead>
            <tr>
                <th>STT</th>
                <th>Lớp học phần</th>
                <th>Ngày</th>
                <th>Tuần</th>
                <th>Tiết học</th>
                <th>Chủ đề</th>
                <th>Ghi chú</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @{
                int i = 1;
                if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>                      
                             <td>@i</td>
                            <td>@item.CourseSection.SectionCode</td>
                            <td>@item.SessionDate.ToShortDateString()</td>
                            <td>@item.Week</td>
                            <td>T @item.CourseSection.DayOfWeek (@item.CourseSection.StartPeriod -> @item.CourseSection.EndPeriod)</td>
                            <td>@item.Topic</td>
                            <td>@item.Note</td>
                            <td>
                                <a asp-action="Mark" asp-route-sessionId="@item.AttendanceSessionId" class="btn btn-primary btn-sm">Điểm danh</a>
                                <a asp-action="Details" asp-route-sessionId="@item.AttendanceSessionId" class="btn btn-primary btn-sm">Chi tiết</a>
                            </td>
                        </tr>
                        i++;
                    }
                }
            }
        </tbody>
    </table>

</div>