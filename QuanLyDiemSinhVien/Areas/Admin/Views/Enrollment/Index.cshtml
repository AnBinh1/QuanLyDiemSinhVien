@model IEnumerable<QuanLyDiemSinhVien.Models.CourseSectionModel>

<div class="card card-outline card-primary shadow-sm mb-4">
    <div class="card-body py-3 px-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap">

            <div class="d-flex align-items-center">
                <div class="d-flex align-items-center justify-content-center rounded mr-3"
                     style="width: 52px; height: 52px; background-color: #e8f1ff; flex-shrink: 0;">
                    <i class="fas fa-chalkboard-teacher text-primary" style="font-size: 24px;"></i>
                </div>
                <h3 class="font-weight-bold text-dark mb-0" style="font-size: 22px;">
                    Danh sách lớp học phần đang mở
                </h3>
            </div>

        </div>
    </div>
</div>

<table class="table table-bordered table-hover text-center align-middle">
    <thead class="table-success">
        <tr>
            <th>STT</th>
            <th>Mã học phần</th>
            <th>Lớp học phần</th>
            <th>Năm học</th>
            <th>Học kỳ</th>
            <th>Số lượng tối đa</th>
            <th>đã đăng ký</th>
            <th>Giảng viên</th>
            <th>Phòng học</th>
            <th>Trạng thái</th>
            <th>Ngày mở</th>
            <th>Ngày đóng</th>
            <th>Ngành đăng ký</th>
            <th>Tuần học</th>
            <th>Thứ(tiết học)</th>
        </tr>
    </thead>
    <tbody>
        @{
            int i = 1;
            if (Model != null && Model.Any())
            {
                foreach (var s in Model)
                {
                    <tr>
                        <td>@i</td>
                        <td>@s.Course?.CourseCode</td>
                        <td>@s.SectionCode</td>
                        <td>@s.AcademicYear</td>
                        <td>@s.Semester</td>
                        <td>@s.MaxStudents</td>
                        <td>@s.RegisteredStudents</td>
                        <td>@s.Lecturer?.FullName</td>
                        <td>@s.Room</td>
                        <td>
                            <span class="badge bg-success">Mở</span>
                        </td>
                        <td>@s.StartDate</td>
                        <td>@s.EndDate</td>
                        <td>@s.Major?.MajorName</td>
                        <td>(@s.StartWeek - @s.EndWeek)</td>
                        <td>T @s.DayOfWeek (@s.StartPeriod,@s.EndPeriod)</td>
                    </tr>
                    i++;
                }
            }
            else
            {
                <tr>
                    <td colspan="15">Chưa có lớp học phần nào được mở.</td>
                </tr>
            }
        }
    </tbody>
</table>
