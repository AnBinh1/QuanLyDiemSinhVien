@model List<QuanLyDiemSinhVien.Models.News>
@{
    ViewData["Title"] = "Quản lý tin tức";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title">Danh sách tin tức</h3>
        <a asp-action="Create" class="btn btn-primary btn-sm ml-auto">
            <i class="fas fa-plus"></i> Thêm tin mới
        </a>
    </div>

    <div class="card-body">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }

        <form method="get" class="form-inline mb-3">
            <input type="text" name="keyword" value="@ViewBag.Keyword"
                   class="form-control mr-2" placeholder="Tìm theo tiêu đề..." />
            <button class="btn btn-default" type="submit">Tìm</button>
        </form>

        <table class="table table-bordered table-hover">
            <thead>
                <tr>
                    <th style="width:90px">Ảnh</th>
                    <th>Tiêu đề</th>
                    <th>Chuyên mục</th>
                    <th>Ngày đăng</th>
                    <th>Nổi bật</th>
                    <th>Trạng thái</th>
                    <th style="width:200px"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var n in Model)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(n.ImageUrl))
                            {
                                <img src="@Url.Content(n.ImageUrl)" style="width:80px;height:50px;object-fit:cover;" />
                            }
                        </td>
                        <td>@n.Title</td>
                        <td>@n.Category</td>
                        <td>@n.PublishedDate.ToString("dd/MM/yyyy")</td>
                        <td>
                            @if (n.IsFeatured)
                            {
                                <span class="badge badge-warning">Nổi bật</span>
                            }
                        </td>
                        <td>
                            <form asp-action="TogglePublish" asp-route-id="@n.Id" method="post" style="display:inline">
                                <button type="submit"
                                        class="btn btn-xs @(n.IsPublished ? "btn-success" : "btn-secondary")">
                                    @(n.IsPublished ? "Đang hiển thị" : "Đang ẩn")
                                </button>
                            </form>
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@n.Id" class="btn btn-sm btn-info">Sửa</a>

                            <form asp-action="Delete" asp-route-id="@n.Id" method="post" style="display:inline"
                                  onsubmit="return confirm('Xóa tin này?');">
                                <button type="submit" class="btn btn-sm btn-danger">Xóa</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="7" class="text-center">Chưa có tin tức.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>