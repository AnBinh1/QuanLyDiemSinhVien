@model QuanLyDiemSinhVien.Models.ClassModel

@{
    ViewData["Title"] = "Thêm Lớp Học";
}

<!-- TIÊU ĐỀ -->
<div class="card card-outline card-primary shadow-sm mb-4">
    <div class="card-body py-3 px-4">
        <div class="d-flex align-items-center">
            <div class="d-flex align-items-center justify-content-center rounded mr-3"
                 style="width: 52px; height: 52px; background-color: #e8f1ff; flex-shrink: 0;">
                <i class="fas fa-plus text-primary" style="font-size: 24px;"></i>
            </div>
            <h3 class="font-weight-bold text-dark mb-0" style="font-size: 22px;">
                Thêm lớp học
            </h3>
        </div>
    </div>
</div>

<!-- FORM -->
<div class="card shadow-sm">
    <div class="card-body px-4 py-4">
        <p class="text-muted mb-4">
            Các trường có dấu <span class="text-danger">*</span> là bắt buộc nhập (không được để trống).
        </p>

        <form asp-action="Create" method="post" asp-controller="Class" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            @Html.AntiForgeryToken()

            <!-- Khoa -->
            <div class="form-group">
                <label for="FacultyId">Chọn khoa/viện <span class="text-danger">*</span></label>
                <select id="FacultyId" class="form-control" asp-items="ViewBag.FacultyList">
                    <option value="">-- Chọn khoa/viện --</option>
                </select>
                <span asp-validation-for="Major.Faculty.Id" class="text-danger"></span>
            </div>

            <!-- Ngành -->
            <div class="form-group">
                <label for="MajorId">Chọn ngành học <span class="text-danger">*</span></label>
                <select asp-for="MajorId" id="MajorId" class="form-control" asp-items="ViewBag.MajorList">
                    <option value="">-- Chọn ngành học --</option>
                </select>
                <span asp-validation-for="MajorId" class="text-danger"></span>
            </div>

            <!-- Tên lớp -->
            <div class="form-group">
                <label asp-for="ClassName">Tên lớp <span class="text-danger">*</span></label>
                <input asp-for="ClassName" class="form-control" placeholder="Mời nhập tên lớp" />
                <span asp-validation-for="ClassName" class="text-danger"></span>
            </div>

            <!-- Mô tả -->
            <div class="form-group">
                <label asp-for="ClassDescription">Mô tả lớp <span class="text-danger">*</span></label>
                <textarea asp-for="ClassDescription" rows="3" class="form-control" placeholder="Yêu cầu nhập mô tả lớp"></textarea>
                <span asp-validation-for="ClassDescription" class="text-danger"></span>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save mr-1"></i> Thêm lớp học
                </button>
                <a asp-action="Index" class="btn btn-secondary ml-2">
                    <i class="fas fa-arrow-left mr-1"></i> Quay lại
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Khi chọn khoa thì load ngành tương ứng
        $('#FacultyId').on('change', function () {
            var facultyId = $(this).val();
            var majorSelect = $('#MajorId');
            majorSelect.empty();
            majorSelect.append('<option value="">-- Chọn ngành học --</option>');

            if (facultyId) {
                $.getJSON('/Admin/Class/GetMajorsByFaculty?facultyId=' + facultyId, function (data) {
                    $.each(data, function (i, item) {
                        majorSelect.append('<option value="' + item.majorId + '">' + item.majorName + '</option>');
                    });
                });
            }
        });
    </script>
}