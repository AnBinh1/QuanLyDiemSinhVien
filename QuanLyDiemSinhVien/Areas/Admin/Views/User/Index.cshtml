@model IEnumerable<IdentityUser>

@{
    ViewData["Title"] = "List User";
}

<div>
    <div class="card card-outline card-primary shadow-sm mb-4">
        <div class="card-body py-3 px-4">
            <div class="d-flex align-items-center justify-content-between flex-wrap">

                <div class="d-flex align-items-center">
                    <div class="d-flex align-items-center justify-content-center rounded mr-3"
                         style="width: 52px; height: 52px; background-color: #e8f1ff; flex-shrink: 0;">
                        <i class="fas fa-chalkboard-teacher text-primary" style="font-size: 24px;"></i>
                    </div>
                    <h3 class="font-weight-bold text-dark mb-0" style="font-size: 22px;">
                        Quản lý tài khoản người dùng
                    </h3>
                </div>
                <form asp-action="Search" method="get" class="d-flex" style="min-width: 380px;">
                    <input type="text" name="searchString" class="form-control mr-2"
                           placeholder="Tìm theo mã hoặc tên lớp học phần..."
                           value="@ViewBag.SearchString" />
                    <button type="submit" class="btn btn-primary text-nowrap">Tìm</button>
                </form>

            </div>
        </div>
    </div>
    <div class="mb-3">
        <a class="btn btn-success" asp-action="Create" asp-controller="User">
            <i class="fas fa-plus mr-1"></i> Thêm User
        </a>
    </div>
   
    <div class="col-sm-12" style="margin-left:5px">
        <table class="table table-bordered table-hover" id="myTable">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>UserName</th>
                    <th>Email</th>
                    <th>PasswordHash</th>
                    <th>Phone</th>
                    @* <th>Role</th> *@
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td width="50">@user.Id</td>
                        <td>@user.UserName</td>
                        <td width="40px">@user.Email</td>
                        <td style="max-width: 270px; word-wrap: break-word;">@user.PasswordHash</td>
                        <td>@(user.PhoneNumber ?? "Chưa có số điện thoại")</td>
                        @* <td>@user.RoleName</td> *@
                        <td>
                            <a class="btn btn-warning btn-sm" asp-action="Edit" asp-controller="User" asp-route-id="@user.Id">Edit</a>
                            <form asp-action="Delete" asp-controller="User" asp-route-id="@user.Id" method="post" onsubmit=" return confirm('bạn có chắc chắn xoá tài khoản này không?')" style="display:inline;">
                                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>