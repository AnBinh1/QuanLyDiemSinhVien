@model IEnumerable<QuanLyDiemSinhVien.Models.LecturerModel>

@{
    ViewData["Title"] = "Thông tin giảng viên";
}

<div>
    <div class="card card-outline card-primary shadow-sm mb-4">
        <div class="card-body py-3 px-4">
            <div class="d-flex align-items-center justify-content-between flex-wrap">

                <div class="d-flex align-items-center">
                    <div class="d-flex align-items-center justify-content-center rounded mr-3"
                         style="width: 52px; height: 52px; background-color: #e8f1ff; flex-shrink: 0;">
                        <i class="fas fa-chalkboard-teacher text-primary" style="font-size: 24px;"></i>
                    </div>
                    <h3 class="font-weight-bold text-dark mb-0" style="font-size: 22px;">
                        Danh sách giảng viên
                    </h3>
                </div>
                <form asp-action="Search" method="get" class="d-flex" style="min-width: 380px;">
                    <input type="text" name="searchString" class="form-control mr-2"
                           placeholder="Tìm theo mã hoặc tên giảng viên..."
                           value="@ViewBag.SearchString" />
                    <button type="submit" class="btn btn-primary text-nowrap">Tìm</button>
                </form>

            </div>
        </div>
    </div>
    <div class="mb-3">
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-user-plus mr-1"></i> Thêm giảng viên mới
        </a>

        <a asp-action="ExportToExcel" asp-route-status="all" class="btn btn-success ml-2">
            <i class="fas fa-file-excel mr-1"></i> Xuất tất cả giảng viên
        </a>

        <a asp-action="ExportToExcel" asp-route-status="active" class="btn btn-success ml-2">
            <i class="fas fa-file-excel mr-1"></i> Xuất giảng viên đang công tác
        </a>

        <a asp-action="ExportToExcel" asp-route-status="inactive" class="btn btn-success ml-2">
            <i class="fas fa-file-excel mr-1"></i> Xuất giảng viên nghỉ công tác
        </a>
    </div>

<div>
    <table class="table table-bordered table-hover text-center align-middle">
        <thead class="table-primary">
            <tr>
                <th>STT</th>
                <th>Mã GV</th>
                <th>Họ và tên</th>
                <th>Giới tính</th>
                <th>Ngày sinh</th>
                <th>Khoa</th>
                <th>Bộ môn / Ngành</th>
                <th>Email</th>
                <th>Số điện thoại</th>
                <th>Chức danh</th>
                <th>Trạng thái</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @{
                int i = 1;
                if (Model != null && Model.Any())
                {
                    foreach (var lecturer in Model)
                    {
                        <tr>
                            <td>@i</td>
                            <td>@lecturer.LecturerCode</td>
                            <td>@lecturer.FullName</td>
                            <td>@lecturer.Gender</td>
                            <td>@lecturer.DateOfBirth.ToString("dd/MM/yyyy")</td>
                            <td>@lecturer.Faculty?.FacultyName</td>
                            <td>@lecturer.Major?.MajorName</td>
                            <td>@lecturer.Email</td>
                            <td>@lecturer.PhoneNumber</td>
                            <td>@lecturer.Position</td>
                            <td>
                                @if (lecturer.IsActive)
                                {
                                    <span class="badge bg-success">Đang công tác</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Đã nghỉ</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@lecturer.LecturerId" class="btn btn-info btn-sm">Xem</a>
                                <a asp-action="Edit" asp-route-id="@lecturer.LecturerId" class="btn btn-warning btn-sm">Sửa</a>
                                <form asp-action="Delete" asp-route-id="@lecturer.LecturerId" method="post" style="display:inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa giảng viên này không?')">
                                    <button type="submit" class="btn btn-danger btn-sm">Xóa</button>
                                </form>
                            </td>
                        </tr>
                        i++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="12">Không có dữ liệu giảng viên nào.</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
