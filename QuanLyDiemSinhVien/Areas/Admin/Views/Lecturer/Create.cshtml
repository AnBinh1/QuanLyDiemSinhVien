@model QuanLyDiemSinhVien.Models.LecturerModel

@{
    ViewData["Title"] = "Thêm Giảng viên";
}

<!-- TIÊU ĐỀ -->
<div class="card card-outline card-primary shadow-sm mb-4">
    <div class="card-body py-3 px-4">
        <div class="d-flex align-items-center">
            <div class="d-flex align-items-center justify-content-center rounded mr-3"
                 style="width: 52px; height: 52px; background-color: #e8f1ff; flex-shrink: 0;">
                <i class="fas fa-user-plus text-primary" style="font-size: 24px;"></i>
            </div>
            <h3 class="font-weight-bold text-dark mb-0" style="font-size: 22px;">
                Thêm giảng viên
            </h3>
        </div>
    </div>
</div>

<!-- FORM -->
<div class="card shadow-sm">
    <div class="card-body px-4 py-4">
        <p class="text-muted mb-4">
            Các trường có dấu <span class="text-danger">*</span> là bắt buộc nhập (không được để trống).
        </p>

        <form asp-action="Create" method="post" asp-controller="Lecturer" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- THÔNG TIN CƠ BẢN -->
            <h5 class="font-weight-bold text-primary border-bottom pb-2 mb-3">
                <i class="fas fa-id-card mr-1"></i> Thông tin cơ bản
            </h5>

            <div class="form-row">
                <div class="form-group col-md-6">
                    <label asp-for="LecturerCode">Mã giảng viên <span class="text-danger">*</span></label>
                    <input asp-for="LecturerCode" class="form-control" />
                    <span asp-validation-for="LecturerCode" class="text-danger"></span>
                </div>
                <div class="form-group col-md-6">
                    <label asp-for="FullName">Họ và tên <span class="text-danger">*</span></label>
                    <input asp-for="FullName" class="form-control" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group col-md-6">
                    <label asp-for="Gender">Giới tính <span class="text-danger">*</span></label>
                    <select asp-for="Gender" class="form-control">
                        <option value="">-- Chọn giới tính --</option>
                        <option value="Nam">Nam</option>
                        <option value="Nữ">Nữ</option>
                    </select>
                    <span asp-validation-for="Gender" class="text-danger"></span>
                </div>
                <div class="form-group col-md-6">
                    <label asp-for="DateOfBirth">Ngày sinh <span class="text-danger">*</span></label>
                    <input asp-for="DateOfBirth" type="date" class="form-control" />
                    <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group col-md-6">
                    <label asp-for="PlaceOfBirth">Nơi sinh</label>
                    <input asp-for="PlaceOfBirth" class="form-control" />
                    <span asp-validation-for="PlaceOfBirth" class="text-danger"></span>
                </div>
                <div class="form-group col-md-6">
                    <label asp-for="IdentityNumber">Số CCCD/CMND</label>
                    <input asp-for="IdentityNumber" class="form-control" />
                    <span asp-validation-for="IdentityNumber" class="text-danger"></span>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group col-md-4">
                    <label asp-for="Ethnicity">Dân tộc</label>
                    <input asp-for="Ethnicity" class="form-control" />
                    <span asp-validation-for="Ethnicity" class="text-danger"></span>
                </div>
                <div class="form-group col-md-4">
                    <label asp-for="Religion">Tôn giáo</label>
                    <input asp-for="Religion" class="form-control" />
                    <span asp-validation-for="Religion" class="text-danger"></span>
                </div>
                <div class="form-group col-md-4">
                    <label asp-for="Nationality">Quốc tịch</label>
                    <input asp-for="Nationality" class="form-control" />
                    <span asp-validation-for="Nationality" class="text-danger"></span>
                </div>
            </div>

            <!-- LIÊN HỆ -->
            <h5 class="font-weight-bold text-primary border-bottom pb-2 mb-3 mt-4">
                <i class="fas fa-address-book mr-1"></i> Thông tin liên hệ
            </h5>

            <div class="form-group">
                <label asp-for="Address">Địa chỉ <span class="text-danger">*</span></label>
                <input asp-for="Address" class="form-control" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>

            <div class="form-row">
                <div class="form-group col-md-6">
                    <label asp-for="PhoneNumber">Số điện thoại <span class="text-danger">*</span></label>
                    <input asp-for="PhoneNumber" class="form-control" />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>
                <div class="form-group col-md-6">
                    <label asp-for="Email">Email</label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
            </div>

            <!-- CÔNG TÁC -->
            <h5 class="font-weight-bold text-primary border-bottom pb-2 mb-3 mt-4">
                <i class="fas fa-briefcase mr-1"></i> Thông tin công tác
            </h5>

            <div class="form-row">
                <div class="form-group col-md-6">
                    <label asp-for="Position">Chức danh</label>
                    <input asp-for="Position" class="form-control" />
                    <span asp-validation-for="Position" class="text-danger"></span>
                </div>
                <div class="form-group col-md-6">
                    <label asp-for="AcademicPosition">Học hàm</label>
                    <input asp-for="AcademicPosition" class="form-control" />
                    <span asp-validation-for="AcademicPosition" class="text-danger"></span>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group col-md-4">
                    <label asp-for="JoinDate">Ngày vào trường</label>
                    <input asp-for="JoinDate" type="date" class="form-control" />
                    <span asp-validation-for="JoinDate" class="text-danger"></span>
                </div>
                <div class="form-group col-md-4">
                    <label asp-for="StartTeachingDate">Ngày bắt đầu giảng dạy</label>
                    <input asp-for="StartTeachingDate" type="date" class="form-control" />
                    <span asp-validation-for="StartTeachingDate" class="text-danger"></span>
                </div>
                <div class="form-group col-md-4">
                    <label asp-for="RetireDate">Ngày nghỉ hưu hoặc thôi việc</label>
                    <input asp-for="RetireDate" type="date" class="form-control" />
                    <span asp-validation-for="RetireDate" class="text-danger"></span>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group col-md-6">
                    <label asp-for="ContractType">Loại hợp đồng <span class="text-danger">*</span></label>
                    <select asp-for="ContractType" class="form-control">
                        <option value="">-- Chọn hợp đồng --</option>
                        <option value="Dài Hạn">Dài Hạn</option>
                        <option value="Ngắn Hạn">Ngắn Hạn</option>
                        <option value="Thử Việc">Thử Việc</option>
                    </select>
                    <span asp-validation-for="ContractType" class="text-danger"></span>
                </div>
                <div class="form-group col-md-6">
                    <label asp-for="IsActive">Trạng thái</label>
                    <select asp-for="IsActive" class="form-control">
                        <option value="true">Đang công tác</option>
                        <option value="false">Tạm nghỉ / Thôi việc</option>
                    </select>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group col-md-6">
                    <label for="FacultyId">Chọn khoa-viện <span class="text-danger">*</span></label>
                    <select asp-for="FacultyId" id="FacultyId" class="form-control" asp-items="ViewBag.FacultyList">
                        <option value="">-- Chọn khoa-viện --</option>
                    </select>
                    <span asp-validation-for="FacultyId" class="text-danger"></span>
                </div>
                <div class="form-group col-md-6">
                    <label for="MajorId">Chọn ngành/bộ môn</label>
                    <select asp-for="MajorId" id="MajorId" class="form-control" asp-items="ViewBag.MajorList">
                        <option value="">-- Chọn ngành --</option>
                    </select>
                    <span asp-validation-for="MajorId" class="text-danger"></span>
                </div>
            </div>

            <!-- TÀI KHOẢN & KHÁC -->
            <h5 class="font-weight-bold text-primary border-bottom pb-2 mb-3 mt-4">
                <i class="fas fa-user-cog mr-1"></i> Tài khoản và khác
            </h5>

            <div class="form-row">
                <div class="form-group col-md-6">
                    <label for="UserId">Chọn tài khoản</label>
                    <select asp-for="UserId" class="form-control" asp-items="ViewBag.Users">
                        <option value="">-- Chọn tài khoản --</option>
                    </select>
                    <span asp-validation-for="UserId" class="text-danger"></span>
                </div>
                <div class="form-group col-md-6">
                    <label asp-for="AvatarFile">Ảnh đại diện</label>
                    <input asp-for="AvatarFile" type="file" class="form-control" />
                    <span asp-validation-for="AvatarFile" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="Notes">Ghi chú <span class="text-danger">*</span></label>
                <textarea asp-for="Notes" rows="3" class="form-control"></textarea>
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save mr-1"></i> Thêm giảng viên
                </button>
                <a asp-action="Index" class="btn btn-secondary ml-2">
                    <i class="fas fa-arrow-left mr-1"></i> Quay lại
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            // Khi chọn Khoa, load Ngành tương ứng
            $('#FacultyId').on('change', function () {
                var facultyId = $(this).val();
                var majorSelect = $('#MajorId');
                majorSelect.empty().append('<option value="">-- Chọn ngành --</option>');

                if (facultyId) {
                    $.getJSON('/Admin/Lecturer/GetMajorsByFaculty?facultyId=' + facultyId, function (data) {
                        $.each(data, function (i, item) {
                            majorSelect.append('<option value="' + item.majorId + '">' + item.majorName + '</option>');
                        });
                    });
                }
            });
        });
    </script>
}