@model IEnumerable<QuanLyDiemSinhVien.Models.StudentModel>

@{
    ViewData["Title"] = "Thông tin sinh viên";
}

<div>
    <div class="card card-outline card-primary shadow-sm mb-4">
        <div class="card-body py-3 px-4">
            <div class="d-flex align-items-center justify-content-between flex-wrap">

                <div class="d-flex align-items-center">
                    <div class="d-flex align-items-center justify-content-center rounded mr-3"
                         style="width: 52px; height: 52px; background-color: #e8f1ff; flex-shrink: 0;">
                        <i class="fas fa-user-graduate text-primary" style="font-size: 24px;"></i>
                    </div>
                    <h3 class="font-weight-bold text-dark mb-0" style="font-size: 22px;">
                        Danh sách sinh viên
                    </h3>
                </div>
                <form asp-action="Search" method="get" class="d-flex" style="min-width: 380px;">
                    <input type="text" name="searchString" class="form-control mr-2"
                           placeholder="Tìm theo mã hoặc tên sinh viên..."
                           value="@ViewBag.SearchString" />
                    <button type="submit" class="btn btn-primary text-nowrap">Tìm</button>
                </form>

            </div>
        </div>
    </div>
    <div class="mb-3">
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-user-plus mr-1"></i> Thêm sinh viên mới
        </a>

        <a asp-action="ExportToExcel" asp-route-status="all" class="btn btn-success ml-2">
            <i class="fas fa-file-excel mr-1"></i> Xuất tất cả sinh viên
        </a>

        <a asp-action="ExportToExcel" asp-route-status="active" class="btn btn-success ml-2">
            <i class="fas fa-file-excel mr-1"></i> Xuất sinh viên còn học
        </a>

        <a asp-action="ExportToExcel" asp-route-status="inactive" class="btn btn-success ml-2">
            <i class="fas fa-file-excel mr-1"></i> Xuất sinh viên nghỉ học
        </a>
    </div>
    

<div >

    <table class="table table-bordered table-hover text-center align-middle">
        <thead class="table-primary">
            <tr>
                <th>STT</th>
                <th>Mã SV</th>
                <th>Họ và tên</th>
                <th>Giới tính</th>
                <th>Ngày sinh</th>
                <th>Số điện thoại</th>
                <th>Email</th>
                <th>Tên lớp</th>
                <th>Ngành học</th>
                <th>Khoa</th>
                <th>Trạng thái</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @{
                int i = 1;
                foreach (var student in Model)
                {
                    <tr>
                        <td>@i</td>
                        <td>@student.StudentCode</td>
                        <td>@student.FullName</td>
                        <td>@student.Gender</td>
                        <td>@student.DateOfBirth.ToString("dd/MM/yyyy")</td>
                        <td>@student.PhoneNumber</td>
                        <td>@student.Email</td>
                        <td>@student.Class?.ClassName</td>
                        <td>@student.Class?.Major?.MajorName</td>
                        <td>@student.Class?.Major?.Faculty?.FacultyName</td>
                        <td>
                            @if (student.IsActive)
                            {
                                <span class="badge bg-success">Đang học</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Ngừng học</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@student.StudentId" class="btn btn-info btn-sm">Xem</a>
                            <a asp-action="Edit" asp-route-id="@student.StudentId" class="btn btn-warning btn-sm">Sửa</a>
                            <form asp-action="Delete" asp-route-id="@student.StudentId" method="post" style="display:inline" onsubmit="return confirm('Bạn có chắc chắn muốn xóa sinh viên này không?')">
                                <button type="submit" class="btn btn-danger btn-sm">Xóa</button>
                            </form>
                        </td>
                    </tr>
                    i++;
                }
            }
        </tbody>
    </table>
</div>
