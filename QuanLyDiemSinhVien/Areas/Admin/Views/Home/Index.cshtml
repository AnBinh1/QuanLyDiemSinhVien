@model QuanLyDiemSinhVien.ViewModels.AdminDashboardViewModel
@using System.Globalization
@using System.Text.Json

@{
    ViewData["Title"] = "Tổng quan";
    var vi = new CultureInfo("vi-VN");
}

<!-- ========== LỜI CHÀO ========== -->
<div class="card card-outline card-primary shadow-sm mb-4">
    <div class="card-body py-3 px-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap">
            <div class="d-flex align-items-center">
                <div class="d-flex align-items-center justify-content-center rounded mr-3"
                     style="width: 52px; height: 52px; background-color: #e8f1ff; flex-shrink: 0;">
                    <i class="fas fa-tachometer-alt text-primary" style="font-size: 24px;"></i>
                </div>
                <div>
                    <h3 class="font-weight-bold text-dark mb-1" style="font-size: 22px;">
                        Xin chào, @Model.AdminName
                    </h3>
                    <p class="text-muted mb-0" style="font-size: 14px;">
                        Tổng quan hoạt động của hệ thống quản lý điểm sinh viên.
                    </p>
                </div>
            </div>
            <div class="text-muted mt-2 mt-md-0">
                <i class="far fa-calendar-alt mr-1"></i>
                @DateTime.Now.ToString("dddd, dd/MM/yyyy", vi)
            </div>
        </div>
    </div>
</div>

<!-- ========== THỐNG KÊ THEO MENU ========== -->
<div class="row">
    <div class="col-lg-3 col-6">
        <div class="small-box bg-info">
            <div class="inner">
                <h3>@Model.TotalStudents</h3>
                <p>Sinh viên (@Model.ActiveStudents đang học)</p>
            </div>
            <div class="icon"><i class="fas fa-user-graduate"></i></div>
            <a asp-area="Admin" asp-controller="Student" asp-action="Index" class="small-box-footer">
                Quản lý sinh viên <i class="fas fa-arrow-circle-right"></i>
            </a>
        </div>
    </div>
    <div class="col-lg-3 col-6">
        <div class="small-box bg-success">
            <div class="inner">
                <h3>@Model.TotalLecturers</h3>
                <p>Giảng viên (@Model.ActiveLecturers đang công tác)</p>
            </div>
            <div class="icon"><i class="fas fa-chalkboard-teacher"></i></div>
            <a asp-area="Admin" asp-controller="Lecturer" asp-action="Index" class="small-box-footer">
                Quản lý giảng viên <i class="fas fa-arrow-circle-right"></i>
            </a>
        </div>
    </div>
    <div class="col-lg-3 col-6">
        <div class="small-box bg-warning">
            <div class="inner">
                <h3>@Model.TotalFaculties</h3>
                <p>Khoa-viện · @Model.TotalMajors ngành · @Model.TotalClasses lớp</p>
            </div>
            <div class="icon"><i class="fas fa-university"></i></div>
            <a asp-area="Admin" asp-controller="Faculty" asp-action="Index" class="small-box-footer">
                Quản lý đào tạo <i class="fas fa-arrow-circle-right"></i>
            </a>
        </div>
    </div>
    <div class="col-lg-3 col-6">
        <div class="small-box bg-danger">
            <div class="inner">
                <h3>@Model.TotalSections</h3>
                <p>Lớp học phần · @Model.TotalCourses học phần</p>
            </div>
            <div class="icon"><i class="fas fa-book-open"></i></div>
            <a asp-area="Admin" asp-controller="CourseSection" asp-action="Index" class="small-box-footer">
                Quản lý học tập <i class="fas fa-arrow-circle-right"></i>
            </a>
        </div>
    </div>
</div>

<div class="row">

    <!-- ================= CỘT TRÁI ================= -->
    <div class="col-lg-8">

        <!-- VIỆC CẦN XỬ LÝ -->
        <div class="card shadow-sm card-outline card-warning">
            <div class="card-header bg-white py-3 px-4">
                <h5 class="font-weight-bold text-dark mb-0">
                    <i class="fas fa-bell text-warning mr-2"></i> Việc cần xử lý
                </h5>
            </div>
            <div class="card-body p-0">
                @if (!Model.Todos.Any())
                {
                    <div class="text-center text-muted py-4">
                        <i class="fas fa-check-circle text-success mr-1"></i> Không có việc cần xử lý.
                    </div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var t in Model.Todos)
                        {
                            <li class="list-group-item px-4">
                                <div class="d-flex align-items-center justify-content-between">
                                    <div class="d-flex align-items-center">
                                        <div class="d-flex align-items-center justify-content-center rounded mr-3 bg-@t.Color"
                                             style="width: 40px; height: 40px; flex-shrink: 0;">
                                            <i class="fas @t.Icon text-white"></i>
                                        </div>
                                        <div>
                                            <div class="font-weight-bold">@t.Title</div>
                                            <small class="text-muted">@t.Description</small>
                                        </div>
                                    </div>
                                    <div class="text-nowrap ml-2">
                                        <span class="badge badge-@t.Color mr-2" style="font-size: 14px;">@t.Count</span>
                                        <a asp-area="Admin" asp-controller="@t.Controller" asp-action="@t.Action"
                                           class="btn btn-sm btn-outline-primary">Xử lý</a>
                                    </div>
                                </div>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>

        <!-- BIỂU ĐỒ SINH VIÊN THEO KHOA-VIỆN -->
        <div class="card shadow-sm">
            <div class="card-header bg-white py-3 px-4">
                <h5 class="font-weight-bold text-dark mb-0">
                    <i class="fas fa-chart-bar text-primary mr-2"></i> Sinh viên theo khoa-viện
                </h5>
            </div>
            <div class="card-body px-4 py-3">
                @if (!Model.StudentsByFaculty.Any())
                {
                    <div class="text-center text-muted py-4">Chưa có dữ liệu sinh viên.</div>
                }
                else
                {
                    <div style="position: relative; height: 280px;">
                        <canvas id="facultyChart"></canvas>
                    </div>
                }
            </div>
        </div>

    </div>
    <!-- ================= HẾT CỘT TRÁI ================= -->
    <!-- ================= CỘT PHẢI ================= -->
    <div class="col-lg-4">

        <!-- CHỨC NĂNG NHANH THEO MENU -->
        <div class="card shadow-sm">
            <div class="card-header bg-white py-3 px-4">
                <h5 class="font-weight-bold text-dark mb-0">
                    <i class="fas fa-bolt text-primary mr-2"></i> Chức năng nhanh
                </h5>
            </div>
            <div class="card-body px-4 py-3">
                <a asp-area="Admin" asp-controller="User" asp-action="Index" class="btn btn-outline-secondary btn-block text-left">
                    <i class="fas fa-users-cog mr-2"></i> Quản lý tài khoản
                    <span class="badge badge-secondary float-right mt-1">@Model.TotalUsers</span>
                </a>
                <a asp-area="Admin" asp-controller="Faculty" asp-action="Index" class="btn btn-outline-warning btn-block text-left">
                    <i class="fas fa-university mr-2"></i> Quản lý đào tạo
                </a>
                <a asp-area="Admin" asp-controller="Student" asp-action="Index" class="btn btn-outline-info btn-block text-left">
                    <i class="fas fa-user-graduate mr-2"></i> Quản lý sinh viên
                </a>
                <a asp-area="Admin" asp-controller="Lecturer" asp-action="Index" class="btn btn-outline-success btn-block text-left">
                    <i class="fas fa-chalkboard-teacher mr-2"></i> Quản lý giảng viên
                </a>
                <a asp-area="Admin" asp-controller="CourseSection" asp-action="Index" class="btn btn-outline-danger btn-block text-left">
                    <i class="fas fa-book-open mr-2"></i> Quản lý học tập
                </a>
                <a asp-area="Admin" asp-controller="News" asp-action="Index" class="btn btn-outline-primary btn-block text-left">
                    <i class="fas fa-newspaper mr-2"></i> Quản lý tin tức
                    <span class="badge badge-primary float-right mt-1">@Model.TotalNews</span>
                </a>
            </div>
        </div>

        <!-- GIỚI TÍNH SINH VIÊN -->
        <div class="card shadow-sm">
            <div class="card-header bg-white py-3 px-4">
                <h5 class="font-weight-bold text-dark mb-0">
                    <i class="fas fa-venus-mars text-primary mr-2"></i> Giới tính sinh viên
                </h5>
            </div>
            <div class="card-body px-4 py-3">
                @if (!Model.StudentsByGender.Any())
                {
                    <div class="text-center text-muted py-4">Chưa có dữ liệu sinh viên.</div>
                }
                else
                {
                    <div style="position: relative; height: 220px;">
                        <canvas id="genderChart"></canvas>
                    </div>
                }
            </div>
        </div>

    </div>
    <!-- ================= HẾT CỘT PHẢI ================= -->

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        var facultyLabels = @Html.Raw(JsonSerializer.Serialize(Model.StudentsByFaculty.Select(x => x.Label)));
        var facultyValues = @Html.Raw(JsonSerializer.Serialize(Model.StudentsByFaculty.Select(x => x.Value)));
        var genderLabels  = @Html.Raw(JsonSerializer.Serialize(Model.StudentsByGender.Select(x => x.Label)));
        var genderValues  = @Html.Raw(JsonSerializer.Serialize(Model.StudentsByGender.Select(x => x.Value)));

        var facultyCanvas = document.getElementById('facultyChart');
        if (facultyCanvas) {
            new Chart(facultyCanvas, {
                type: 'bar',
                data: {
                    labels: facultyLabels,
                    datasets: [{
                        label: 'Số sinh viên',
                        data: facultyValues,
                        backgroundColor: '#007bff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
                }
            });
        }

        var genderCanvas = document.getElementById('genderChart');
        if (genderCanvas) {
            new Chart(genderCanvas, {
                type: 'doughnut',
                data: {
                    labels: genderLabels,
                    datasets: [{
                        data: genderValues,
                        backgroundColor: ['#17a2b8', '#e83e8c', '#6c757d']
                    }]
                },
                options: { responsive: true, maintainAspectRatio: false }
            });
        }
    </script>
}