@model IEnumerable<QuanLyDiemSinhVien.Models.CourseSectionModel>

@{
    ViewData["Title"] = "Danh sách lớp học phần";
}

<div>
    <div class="card card-outline card-primary shadow-sm mb-4">
        <div class="card-body py-3 px-4">
            <div class="d-flex align-items-center justify-content-between flex-wrap">

                <div class="d-flex align-items-center">
                    <div class="d-flex align-items-center justify-content-center rounded mr-3"
                         style="width: 52px; height: 52px; background-color: #e8f1ff; flex-shrink: 0;">
                        <i class="fas fa-chalkboard-teacher text-primary" style="font-size: 24px;"></i>
                    </div>
                    <h3 class="font-weight-bold text-dark mb-0" style="font-size: 22px;">
                        Danh sách lớp học phần
                    </h3>
                </div>
                <form asp-action="Search" method="get" class="d-flex" style="min-width: 380px;">
                    <input type="text" name="searchString" class="form-control mr-2"
                           placeholder="Tìm theo mã hoặc tên lớp học phần..."
                           value="@ViewBag.SearchString" />
                    <button type="submit" class="btn btn-primary text-nowrap">Tìm</button>
                </form>

            </div>
        </div>
    </div>
    <div class="mb-3">
        <a class="btn btn-success" asp-action="Create" asp-controller="CourseSection">
            <i class="fas fa-plus mr-1"></i> Thêm mới lớp học phần
        </a>
    </div>

    <table class="table table-bordered table-hover text-center align-middle">
        <thead class="table-primary">
            <tr>
                <th>STT</th>
                <th>Mã học phần</th>
                <th>Lớp học phần</th>
                <th>Năm học</th>
                <th>Học kỳ</th>
                <th>Số lượng tối đa</th>
                <th>Số sinh viên đã đăng ký</th>
                <th>Giảng viên phụ trách</th>
                @* <th>Ngành học</th> *@
                <th>Phòng học</th>
                <th>Trạng thái</th>
                <th>Hành động</th>
            </tr>
        </thead>
        <tbody>
            @{
                int i = 1;
                if (Model != null && Model.Any())
                {
                    foreach (var Section in Model)
                    {
                        <tr>
                            <td>@i</td>
                            <td>@Section.Course?.CourseCode</td>
                            <td>@Section.SectionCode</td>
                            <td>@Section.AcademicYear</td>
                            <td>@Section.Semester</td>
                            <td>@Section.MaxStudents</td>
                            <td>@Section.RegisteredStudents</td>
                            <td>@Section.Lecturer?.FullName</td>
                            <td>@Section.Room</td>
                            <td>
                                @if(Section.Status == "Open")
                                {
                                    <span class="badge bg-success">Mở</span>
                                }
                                else if(Section.Status == "Closed")
                                {
                                    <span class="badge bg-danger">Đóng</span>
                                }
                                else if (Section.Status == "Postponed")
                                {
                                    <span class="badge bg-warning">Tạm Hoãn</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">@Section.Status</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Edit" asp-route-id="@Section.SectionId" class="btn btn-warning btn-sm">Sửa</a>
                                <form asp-action="Delete" asp-route-id="@Section.SectionId" method="post" style="display:inline;" onsubmit="return confirm('Bạn có chắc chắn muốn xóa lớp học phần này không?')">
                                    <button type="submit" class="btn btn-danger btn-sm">Xóa</button>
                                </form>
                            </td>
                        </tr>
                        i++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="11">Không có dữ liệu lớp học phần nào.</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
