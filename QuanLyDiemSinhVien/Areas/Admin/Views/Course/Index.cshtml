@model IEnumerable<CourseModel>

@{
    ViewData["Title"] = "Danh sách học phần";
}

<div>
    <div class="card card-outline card-primary shadow-sm mb-4">
        <div class="card-body py-3 px-4">
            <div class="d-flex align-items-center justify-content-between flex-wrap">

                <div class="d-flex align-items-center">
                    <div class="d-flex align-items-center justify-content-center rounded mr-3"
                         style="width: 52px; height: 52px; background-color: #e8f1ff; flex-shrink: 0;">
                        <i class="fas fa-book text-primary" style="font-size: 24px;"></i>
                    </div>
                    <h3 class="font-weight-bold text-dark mb-0" style="font-size: 22px;">
                        Quản lý học phần
                    </h3>
                </div>
                <form asp-action="Search" method="get" class="d-flex" style="min-width: 380px;">
                    <input type="text" name="searchString" class="form-control mr-2"
                           placeholder="Tìm theo mã hoặc tên học phần..."
                           value="@ViewBag.SearchString" />
                    <button type="submit" class="btn btn-primary text-nowrap">Tìm</button>
                </form>

            </div>
        </div>
    </div>
    <div class="mb-3">
        <a class="btn btn-success" asp-action="Create" asp-controller="Course">
            <i class="fas fa-plus mr-1"></i> Thêm học phần
        </a>
    </div>
    <div class="col-sm-12" style="margin-left:5px">
        <table class="table table-bordered table-hover" id="myTable">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Mã Học Phần</th>
                    <th>Tên Học Phần</th>
                    <th>Số Tín Chỉ</th>
                    <th>Mô Tả</th>
                    <th>loại Học Phần</th>
                    <th>Học Phần tiên quyết</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>

                        <td width="50">@item.CourseId</td>
                        <td style="text-align:end">@item.CourseCode</td>
                        <td>@item.CourseName</td>
                        <td>@item.Credits</td>
                        <td width="300px">@item.Description</td>
                        <td>@item.CourseType</td>
                        <td>
                            @(item.PrerequisiteCourse != null
                                                    ? $"{item.PrerequisiteCourse.CourseId} - {item.PrerequisiteCourse.CourseName}"
                                                    : "Không có")
                    </td>
                    <td>
                        <a class="btn btn-warning btn-sm" asp-action="Edit" asp-controller="Course" asp-route-id="@item.CourseId">Sửa</a>
                        <form asp-action="Delete" asp-controller="Course" asp-route-id="@item.CourseId" method="post" onsubmit=" return confirm('bạn có chắc chắn xoá học phần này không?')" style="display:inline;">
                            <button type="submit" class="btn btn-danger btn-sm">Xoá</button>
                        </form>
                    </td>

                    </tr>
                                }
            </tbody>
        </table>
    </div>

</div>