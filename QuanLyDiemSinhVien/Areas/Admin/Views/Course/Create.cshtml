@model QuanLyDiemSinhVien.Models.CourseModel
@{
    ViewData["Title"] = "Thêm học phần";
}

<!-- TIÊU ĐỀ -->
<div class="card card-outline card-primary shadow-sm mb-4">
    <div class="card-body py-3 px-4">
        <div class="d-flex align-items-center">
            <div class="d-flex align-items-center justify-content-center rounded mr-3"
                 style="width: 52px; height: 52px; background-color: #e8f1ff; flex-shrink: 0;">
                <i class="fas fa-plus text-primary" style="font-size: 24px;"></i>
            </div>
            <h3 class="font-weight-bold text-dark mb-0" style="font-size: 22px;">
                Thêm học phần
            </h3>
        </div>
    </div>
</div>

<!-- FORM -->
<div class="card shadow-sm">
    <div class="card-body px-4 py-4">
        <p class="text-muted mb-4">
            Các trường có dấu <span class="text-danger">*</span> là bắt buộc nhập (không được để trống).
        </p>

        <form asp-action="Create" asp-controller="Course" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="CourseCode">Mã học phần <span class="text-danger">*</span></label>
                <input asp-for="CourseCode" class="form-control" maxlength="20" placeholder="Mời nhập mã học phần" />
                <span asp-validation-for="CourseCode" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="CourseName">Tên học phần <span class="text-danger">*</span></label>
                <input asp-for="CourseName" class="form-control" maxlength="200" placeholder="Mời nhập tên học phần" />
                <span asp-validation-for="CourseName" class="text-danger"></span>
            </div>

            <div class="form-row">
                <div class="form-group col-md-6">
                    <label asp-for="Credits">Số tín chỉ <span class="text-danger">*</span></label>
                    <input asp-for="Credits" type="number" class="form-control" placeholder="Mời nhập số tín chỉ" />
                    <span asp-validation-for="Credits" class="text-danger"></span>
                </div>

                <div class="form-group col-md-6">
                    <label asp-for="CourseType">Loại học phần <span class="text-danger">*</span></label>
                    <select asp-for="CourseType" asp-items="ViewBag.CourseTypes" class="form-control">
                        <option value="">-- Chọn loại học phần --</option>
                    </select>
                    <span asp-validation-for="CourseType" class="text-danger"></span>
                </div>
            </div>

            <div class="form-group">
                <label asp-for="PrerequisiteCourseId">Học phần tiên quyết</label>
                <select asp-for="PrerequisiteCourseId" asp-items="ViewBag.Courses" class="form-control">
                    <option value="">-- Không có --</option>
                </select>
                <span asp-validation-for="PrerequisiteCourseId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description">Mô tả học phần <span class="text-danger">*</span></label>
                <textarea asp-for="Description" class="form-control" rows="4" maxlength="500" placeholder="Mời nhập mô tả học phần"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save mr-1"></i> Thêm học phần
                </button>
                <a asp-action="Index" class="btn btn-secondary ml-2">
                    <i class="fas fa-arrow-left mr-1"></i> Quay lại
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}