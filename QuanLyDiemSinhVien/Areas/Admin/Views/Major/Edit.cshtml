@model MajorModel
@{
    ViewData["title"] = "Cập nhật ngành học";
}

<!-- TIÊU ĐỀ -->
<div class="card card-outline card-primary shadow-sm mb-4">
    <div class="card-body py-3 px-4">
        <div class="d-flex align-items-center">
            <div class="d-flex align-items-center justify-content-center rounded mr-3"
                 style="width: 52px; height: 52px; background-color: #e8f1ff; flex-shrink: 0;">
                <i class="fas fa-edit text-primary" style="font-size: 24px;"></i>
            </div>
            <h3 class="font-weight-bold text-dark mb-0" style="font-size: 22px;">
                Cập nhật ngành học
            </h3>
        </div>
    </div>
</div>

<!-- FORM -->
<div class="card shadow-sm">
    <div class="card-body px-4 py-4">
        <p class="text-muted mb-4">
            Các trường có dấu <span class="text-danger">*</span> là bắt buộc nhập (không được để trống).
        </p>

        <form asp-action="Edit" asp-controller="Major" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="MajorId" />

            <div class="form-group">
                <label asp-for="MajorCode">Mã ngành học <span class="text-danger">*</span></label>
                <input asp-for="MajorCode" required class="form-control" placeholder="Mời nhập mã ngành học" />
                <span asp-validation-for="MajorCode" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="MajorName">Tên ngành học <span class="text-danger">*</span></label>
                <input asp-for="MajorName" required class="form-control" placeholder="Mời nhập tên ngành học" />
                <span asp-validation-for="MajorName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="MajorDescription">Mô tả ngành học <span class="text-danger">*</span></label>
                <textarea asp-for="MajorDescription" rows="3" class="form-control" placeholder="Yêu cầu nhập mô tả ngành học"></textarea>
                <span asp-validation-for="MajorDescription" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="FacultyId">Khoa-viện <span class="text-danger">*</span></label>
                <select asp-for="FacultyId" asp-items="ViewBag.FacultyList" class="form-control">
                    <option value="">-- Chọn khoa-viện --</option>
                </select>
                <span asp-validation-for="FacultyId" class="text-danger"></span>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save mr-1"></i> Cập nhật ngành học
                </button>
                <a asp-action="Index" class="btn btn-secondary ml-2">
                    <i class="fas fa-arrow-left mr-1"></i> Quay lại
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}