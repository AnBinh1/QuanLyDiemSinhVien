@model QuanLyDiemSinhVien.Models.CourseSectionModel

@{
    ViewData["Title"] = "Phân công giảng dạy";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h3 class="text-primary mb-1">

                <i class="fas fa-user-plus mr-2"></i>

                Phân công giảng dạy

            </h3>

            <p class="text-muted mb-0">
                Chọn giảng viên phụ trách lớp học phần
            </p>

        </div>


        <a asp-area="Admin"
           asp-controller="TeachingAssignment"
           asp-action="Index"
           class="btn btn-secondary">

            <i class="fas fa-arrow-left mr-1"></i>

            Quay lại

        </a>

    </div>


    <div class="card shadow-sm">

        <div class="card-header bg-primary text-white">

            <h5 class="mb-0">

                <i class="fas fa-book mr-2"></i>

                Thông tin lớp học phần

            </h5>

        </div>


        <div class="card-body">

            <div class="row mb-4">

                <div class="col-md-4">

                    <strong>
                        Mã lớp học phần:
                    </strong>

                    <span class="text-primary ml-2">

                        @Model.SectionCode

                    </span>

                </div>


                <div class="col-md-4">

                    <strong>
                        Học phần:
                    </strong>

                    <span class="text-primary ml-2">

                        @Model.Course?.CourseName

                    </span>

                </div>


                <div class="col-md-2">

                    <strong>
                        Học kỳ:
                    </strong>

                    <span class="ml-2">

                        @Model.Semester

                    </span>

                </div>


                <div class="col-md-2">

                    <strong>
                        Năm học:
                    </strong>

                    <span class="ml-2">

                        @Model.AcademicYear

                    </span>

                </div>

            </div>


            <hr />


            <form asp-area="Admin"
                  asp-controller="TeachingAssignment"
                  asp-action="Assign"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@Model.SectionId" />


                <div class="form-group">

                    <label for="lecturerId">

                        <i class="fas fa-user-tie mr-1"></i>

                        Giảng viên phụ trách

                    </label>


                    <select id="lecturerId"
                            name="lecturerId"
                            class="form-control"
                            asp-items="ViewBag.Lecturers">

                        <option value="">
                            -- Chọn giảng viên --
                        </option>

                    </select>


                    <span class="text-danger">
                        @Html.ValidationMessage("lecturerId")
                    </span>

                </div>


                <div class="mt-4">

                    <button type="submit"
                            class="btn btn-success">

                        <i class="fas fa-save mr-2"></i>

                        Lưu phân công

                    </button>


                    <a asp-area="Admin"
                       asp-controller="TeachingAssignment"
                       asp-action="Index"
                       class="btn btn-secondary ml-2">

                        Hủy

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>