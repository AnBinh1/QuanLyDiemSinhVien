    <style>
        /* =========================================
                   SIDEBAR - HIỆU ỨNG HOVER MENU
                ========================================= */
        /* Mục menu con */
        .main-sidebar .nav-treeview .nav-link {
            color: #343a40 !important;
            transition: all 0.2s ease;
            border-radius: 6px;
            margin: 2px 8px;
        }

            /* Hover vào menu con */
            .main-sidebar .nav-treeview .nav-link:hover {
                background-color: #e8f1ff !important;
                color: #007bff !important;
            }

                /* Icon của menu con khi hover */
                .main-sidebar .nav-treeview .nav-link:hover i {
                    color: #007bff !important;
                }

        /* =========================================
                   MENU CHA
                ========================================= */

        .main-sidebar .nav-sidebar > .nav-item > .nav-link {
            color: #343a40 !important;
            transition: all 0.2s ease;
            border-radius: 6px;
            margin: 2px 6px;
        }

            /* Hover menu cha */
            .main-sidebar .nav-sidebar > .nav-item > .nav-link:hover {
                background-color: #e8f1ff !important;
                color: #007bff !important;
            }

                /* Icon menu cha khi hover */
                .main-sidebar .nav-sidebar > .nav-item > .nav-link:hover > i {
                    color: #007bff !important;
                }


        /* =========================================
                   MENU ĐANG ACTIVE
                ========================================= */

        .main-sidebar .nav-sidebar .nav-link.active {
            background-color: #007bff !important;
            color: white !important;
        }

            /* Icon active */
            .main-sidebar .nav-sidebar .nav-link.active i {
                color: white !important;
            }


        /* =========================================
                   MENU CON ACTIVE
                ========================================= */

        .main-sidebar .nav-treeview .nav-link.active {
            background-color: #e8f1ff !important;
            color: #007bff !important;
        }

            .main-sidebar .nav-treeview .nav-link.active i {
                color: #007bff !important;
            }
    </style>
