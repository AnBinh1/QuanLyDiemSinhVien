@{
    ViewData["Title"] = "Điểm rèn luyện";
}

<div class="container-fluid">
    <div class="card card-outline card-primary shadow-sm">
        <div class="card-header">
            <h3 class="card-title">
                <i class="fas fa-medal mr-2"></i>
                Điểm rèn luyện sinh viên
            </h3>
        </div>

        <div class="card-body">
            <div class="alert alert-info">
                <i class="fas fa-info-circle mr-1"></i>
                Chức năng quản lý điểm rèn luyện đang được xây dựng.
            </div>

            <p>
                Tại đây, sinh viên sẽ có thể xem điểm rèn luyện
                theo từng học kỳ, tự đánh giá và theo dõi kết quả
                sau khi được xét duyệt.
            </p>
        </div>
    </div>
</div>
