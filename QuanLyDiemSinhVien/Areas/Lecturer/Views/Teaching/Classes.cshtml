@model List<QuanLyDiemSinhVien.Models.CourseSectionModel>

@{
    ViewData["Title"] = "Lớp học phần";

    var semesters = ViewBag.Semesters as List<string>
                     ?? new List<string>();

    var academicYears = ViewBag.AcademicYears as List<string>
                        ?? new List<string>();

    string selectedSemester = ViewBag.Semester as string ?? "";
    string selectedAcademicYear = ViewBag.AcademicYear as string ?? "";
    string keyword = ViewBag.Keyword as string ?? "";
}

<div class="container-fluid">

    <!-- TIÊU ĐỀ TRANG -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="text-primary mb-1">
                <i class="fas fa-chalkboard-teacher mr-2"></i>
                Lớp học phần
            </h3>
            <p class="text-muted mb-0">
                Danh sách các lớp học phần bạn đang phụ trách
            </p>
        </div>
    </div>

    <!-- BỘ LỌC -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="fas fa-filter mr-2"></i>
                Tìm kiếm và lọc
            </h5>
        </div>

        <div class="card-body">
            <form asp-area="Lecturer"
                  asp-controller="Teaching"
                  asp-action="Classes"
                  method="get">

                <div class="row">

                    <!-- HỌC KỲ -->
                    <div class="col-md-3 mb-3">
                        <label class="font-weight-bold">Học kỳ</label>
                        <select name="semester" class="form-control">
                            <option value="">-- Tất cả học kỳ --</option>
                            @foreach (var item in semesters)
                            {
                                if (item == selectedSemester)
                                {
                                    <option value="@item" selected>@item</option>
                                }
                                else
                                {
                                    <option value="@item">@item</option>
                                }
                            }
                        </select>
                    </div>

                    <!-- NĂM HỌC -->
                    <div class="col-md-3 mb-3">
                        <label class="font-weight-bold">Năm học</label>
                        <select name="academicYear" class="form-control">
                            <option value="">-- Tất cả năm học --</option>
                            @foreach (var item in academicYears)
                            {
                                if (item == selectedAcademicYear)
                                {
                                    <option value="@item" selected>@item</option>
                                }
                                else
                                {
                                    <option value="@item">@item</option>
                                }
                            }
                        </select>
                    </div>

                    <!-- TỪ KHÓA -->
                    <div class="col-md-4 mb-3">
                        <label class="font-weight-bold">Tìm kiếm</label>
                        <input type="text"
                               name="keyword"
                               value="@keyword"
                               class="form-control"
                               placeholder="Mã lớp, mã học phần hoặc tên học phần..." />
                    </div>

                    <!-- NÚT -->
                    <div class="col-md-2 mb-3 d-flex align-items-end">
                        <div class="w-100">
                            <button type="submit" class="btn btn-primary btn-block">
                                <i class="fas fa-search mr-1"></i>
                                Tìm kiếm
                            </button>
                        </div>
                    </div>

                </div>
            </form>
        </div>
    </div>

    <!-- DANH SÁCH LỚP HỌC PHẦN -->
    <div class="card shadow-sm">

        <div class="card-header bg-primary text-white">
            <div class="d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="fas fa-list mr-2"></i>
                    Danh sách lớp học phần
                </h5>
                <span class="badge badge-light">
                    @Model.Count lớp
                </span>
            </div>
        </div>

        <div class="card-body">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-bordered table-hover mb-0">

                        <thead class="thead-light">
                            <tr>
                                <th style="width:60px;" class="text-center">STT</th>
                                <th style="width:150px;">Mã lớp học phần</th>
                                <th>Học phần</th>
                                <th style="width:100px;" class="text-center">Học kỳ</th>
                                <th style="width:120px;" class="text-center">Năm học</th>
                                <th style="width:130px;" class="text-center">Số sinh viên</th>
                                <th style="width:120px;" class="text-center">Trạng thái</th>
                                <th style="width:230px;" class="text-center">Thao tác</th>
                            </tr>
                        </thead>

                        <tbody>
                            @{
                                int stt = 1;
                            }

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <!-- STT -->
                                    <td class="text-center align-middle">@stt</td>

                                    <!-- MÃ LỚP -->
                                    <td class="align-middle">
                                        <strong class="text-primary">
                                            @item.SectionCode
                                        </strong>
                                    </td>

                                    <!-- HỌC PHẦN -->
                                    <td class="align-middle">
                                        @if (item.Course != null)
                                        {
                                            <div>
                                                <strong>@item.Course.CourseName</strong>
                                            </div>

                                            <small class="text-muted">
                                                @item.Course.CourseCode
                                                ·
                                                @item.Course.Credits tín chỉ
                                            </small>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                Chưa có thông tin học phần
                                            </span>
                                        }
                                    </td>

                                    <!-- HỌC KỲ -->
                                    <td class="text-center align-middle">
                                        <span class="badge badge-info">
                                            @item.Semester
                                        </span>
                                    </td>

                                    <!-- NĂM HỌC -->
                                    <td class="text-center align-middle">
                                        @item.AcademicYear
                                    </td>

                                    <!-- SỐ SINH VIÊN -->
                                    <td class="text-center align-middle">
                                        <span class="font-weight-bold">
                                            @item.RegisteredStudents
                                        </span>
                                        <span class="text-muted">
                                            / @item.MaxStudents
                                        </span>
                                    </td>

                                    <!-- TRẠNG THÁI -->
                                    <td class="text-center align-middle">
                                        @if (item.Status == "Open")
                                        {
                                            <span class="badge badge-success">
                                                <i class="fas fa-check-circle mr-1"></i>
                                                Đang mở
                                            </span>
                                        }
                                        else if (item.Status == "Closed")
                                        {
                                            <span class="badge badge-secondary">
                                                <i class="fas fa-lock mr-1"></i>
                                                Đã đóng
                                            </span>
                                        }
                                        else if (item.Status == "Postponed")
                                        {
                                            <span class="badge badge-warning">
                                                <i class="fas fa-pause-circle mr-1"></i>
                                                Tạm hoãn
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-light">
                                                @item.Status
                                            </span>
                                        }
                                    </td>

                                    <!-- THAO TÁC -->
                                    <td class="text-center align-middle">

                                        <a asp-area="Lecturer"
                                           asp-controller="Teaching"
                                           asp-action="Details"
                                           asp-route-id="@item.SectionId"
                                           class="btn btn-sm btn-info">
                                            <i class="fas fa-eye mr-1"></i>
                                            Xem
                                        </a>

                                        <a asp-area="Lecturer"
                                           asp-controller="Attendance"
                                           asp-action="Index"
                                           asp-route-sectionId="@item.SectionId"
                                           class="btn btn-sm btn-primary">
                                            <i class="fas fa-user-check mr-1"></i>
                                            Điểm danh
                                        </a>

                                    </td>

                                </tr>

                                stt++;
                            }
                        </tbody>

                    </table>
                </div>
            }
            else
            {
                <!-- KHÔNG CÓ DỮ LIỆU -->
                <div class="text-center py-5">

                    <i class="fas fa-chalkboard fa-4x text-muted mb-3"></i>

                    <h5 class="text-muted">
                        Không tìm thấy lớp học phần
                    </h5>

                    @if (!string.IsNullOrWhiteSpace(keyword)
                                    || !string.IsNullOrWhiteSpace(selectedSemester)
                                    || !string.IsNullOrWhiteSpace(selectedAcademicYear))
                    {
                        <p class="text-muted mb-3">
                            Không có lớp học phần nào phù hợp với điều kiện tìm kiếm.
                        </p>

                        <a asp-area="Lecturer"
                           asp-controller="Teaching"
                           asp-action="Classes"
                           class="btn btn-outline-primary">
                            <i class="fas fa-redo mr-1"></i>
                            Xóa bộ lọc
                        </a>
                    }
                    else
                    {
                        <p class="text-muted mb-0">
                            Hiện tại bạn chưa được phân công lớp học phần nào.
                        </p>
                    }

                </div>
            }

        </div>
    </div>

</div>