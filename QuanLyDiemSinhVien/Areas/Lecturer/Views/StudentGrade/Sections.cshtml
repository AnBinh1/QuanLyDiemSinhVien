@model List<QuanLyDiemSinhVien.Models.CourseSectionModel>

@{
    ViewData["Title"] = "Quản lý điểm";
}

<div class="container-fluid">

    <!-- TIÊU ĐỀ TRANG: QUẢN LÝ ĐIỂM -->
    <div class="card card-outline card-primary shadow-sm mb-4">
        <div class="card-body py-3 px-4">
            <div class="d-flex align-items-center">

                <!-- ICON -->
                <div class="d-flex align-items-center justify-content-center rounded mr-3"
                     style="width: 52px; height: 52px; background-color: #e8f1ff; flex-shrink: 0;">
                    <i class="fas fa-graduation-cap text-primary"
                       style="font-size: 24px;"></i>
                </div>

                <!-- NỘI DUNG -->
                <div>
                    <h3 class="font-weight-bold text-dark mb-1"
                        style="font-size: 22px;">
                        Quản lý điểm
                    </h3>

                    <p class="text-muted mb-0" style="font-size: 14px;">
                        Theo dõi, nhập và quản lý kết quả học tập theo từng lớp học phần.
                    </p>
                </div>

            </div>
        </div>
    </div>


    <!-- Danh sách lớp học phần -->
    <div class="card shadow-sm">

        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="fas fa-list mr-2"></i>
                Danh sách lớp học phần
            </h5>
        </div>


        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-bordered table-hover">

                    <thead class="thead-light">
                        <tr>

                            <th style="width: 60px;" class="text-center">
                                STT
                            </th>

                            <th>
                                Mã lớp học phần
                            </th>

                            <th>
                                Tên học phần
                            </th>

                            <th>
                                Học kỳ
                            </th>

                            <th>
                                Năm học
                            </th>

                            <th>
                                Giảng viên
                            </th>

                            <th class="text-center">
                                Số sinh viên
                            </th>

                            <th style="width: 180px;" class="text-center">
                                Thao tác
                            </th>

                        </tr>
                    </thead>


                    <tbody>

                        @{
                            int stt = 1;
                        }

                        @foreach (var item in Model)
                        {
                            <tr>

                                <!-- STT -->
                                <td class="text-center">
                                    @stt
                                </td>


                                <!-- Mã lớp học phần -->
                                <td>
                                    <strong>
                                        @item.SectionCode
                                    </strong>
                                </td>


                                <!-- Tên học phần -->
                                <td>
                                    @item.Course?.CourseName
                                </td>


                                <!-- Học kỳ -->
                                <td>
                                    @item.Semester
                                </td>


                                <!-- Năm học -->
                                <td>
                                    @item.AcademicYear
                                </td>


                                <!-- Giảng viên -->
                                <td>
                                    @item.Lecturer?.FullName
                                </td>


                                <!-- Số sinh viên -->
                                <td class="text-center">

                                    <span class="badge badge-info">
                                        @(ViewBag.SectionStudentCounts[item.SectionId])
                                        sinh viên
                                    </span>

                                </td>


                                <!-- THAO TÁC -->
                                <td class="text-center">

                                    <a asp-area="Lecturer"
                                       asp-controller="StudentGrade"
                                       asp-action="Enter"
                                       asp-route-sectionId="@item.SectionId"
                                       class="btn btn-sm btn-primary mb-1">

                                        <i class="fas fa-edit mr-1"></i>
                                        Nhập điểm

                                    </a>


                                    <a asp-area="Lecturer"
                                       asp-controller="StudentGrade"
                                       asp-action="Index"
                                       asp-route-sectionId="@item.SectionId"
                                       class="btn btn-sm btn-info mb-1">

                                        <i class="fas fa-eye mr-1"></i>
                                        Xem điểm

                                    </a>

                                </td>

                            </tr>

                            stt++;
                        }

                    </tbody>

                </table>

            </div>
        </div>

    </div>

</div>