@model QuanLyDiemSinhVien.Models.LecturerDashboardViewModel
@using System.Globalization

@{
    ViewData["Title"] = "Tổng quan";
    var today = DateTime.Today;
    var vi = new CultureInfo("vi-VN");
}

<!-- ========== TỔNG QUAN + HỒ SƠ CÁ NHÂN ========== -->
<div class="card card-outline card-primary shadow-sm mb-4">
    <div class="card-body py-3 px-4">
        <div class="d-flex align-items-center justify-content-between flex-wrap">

            <div class="d-flex align-items-center">
                @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                {
                    <img src="@Model.AvatarUrl" alt="Avatar" class="rounded-circle mr-3"
                         style="width: 64px; height: 64px; object-fit: cover;" />
                }
                else
                {
                    <div class="d-flex align-items-center justify-content-center rounded-circle mr-3"
                         style="width: 64px; height: 64px; background-color: #e8f1ff; flex-shrink: 0;">
                        <i class="fas fa-user text-primary" style="font-size: 28px;"></i>
                    </div>
                }
                <div>
                    <h3 class="font-weight-bold text-dark mb-1" style="font-size: 22px;">
                        Xin chào, @Model.FullName
                    </h3>
                    <p class="text-muted mb-0" style="font-size: 14px;">
                        @Model.Position · Mã GV: @Model.LecturerCode · @Model.FacultyName
                    </p>
                </div>
            </div>

            <div class="text-right mt-2 mt-md-0">
                <div class="text-muted mb-2">
                    <i class="far fa-calendar-alt mr-1"></i>
                    @DateTime.Now.ToString("dddd, dd/MM/yyyy", vi)
                </div>
                <a asp-controller="Profile" asp-action="Index" class="btn btn-sm btn-outline-primary">
                    <i class="fas fa-user mr-1"></i> Hồ sơ cá nhân
                </a>
            </div>

        </div>
    </div>
</div>

<!-- ========== THỐNG KÊ NHANH ========== -->
<div class="row">
    <div class="col-lg-3 col-6">
        <div class="small-box bg-info">
            <div class="inner">
                <h3>@Model.Sections.Count</h3>
                <p>Lớp học phần phụ trách</p>
            </div>
            <div class="icon"><i class="fas fa-chalkboard-teacher"></i></div>
        </div>
    </div>
    <div class="col-lg-3 col-6">
        <div class="small-box bg-success">
            <div class="inner">
                <h3>@Model.TodaySchedule.Count</h3>
                <p>Buổi dạy hôm nay</p>
            </div>
            <div class="icon"><i class="fas fa-calendar-day"></i></div>
        </div>
    </div>
    <div class="col-lg-3 col-6">
        <div class="small-box bg-warning">
            <div class="inner">
                <h3>@Model.SectionsPendingGrade</h3>
                <p>Lớp chưa nhập xong điểm</p>
            </div>
            <div class="icon"><i class="fas fa-star"></i></div>
        </div>
    </div>
    <div class="col-lg-3 col-6">
        <div class="small-box bg-danger">
            <div class="inner">
                <h3>@Model.SessionsNotTaken</h3>
                <p>Buổi chưa điểm danh</p>
            </div>
            <div class="icon"><i class="fas fa-clipboard-check"></i></div>
        </div>
    </div>
</div>

<div class="row">

    <!-- ================= CỘT TRÁI ================= -->
    <div class="col-lg-8">

        <!-- GIẢNG DẠY: LỊCH HÔM NAY -->
        <div class="card shadow-sm">
            <div class="card-header bg-white d-flex align-items-center justify-content-between py-3 px-4">
                <h5 class="font-weight-bold text-dark mb-0">
                    <i class="fas fa-calendar-day text-primary mr-2"></i> Lịch giảng dạy hôm nay
                </h5>
                <a asp-area="Lecturer" asp-controller="Teaching" asp-action="Classes" class="btn btn-sm btn-outline-primary">
                    Xem tất cả lớp <i class="fas fa-arrow-right ml-1"></i>
                </a>
            </div>
            <div class="card-body px-4 py-3">
                @if (!Model.TodaySchedule.Any())
                {
                    <div class="text-center text-muted py-4">
                        <i class="far fa-smile fa-2x mb-2"></i>
                        <div>Hôm nay bạn không có lịch giảng dạy.</div>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="thead-light">
                                <tr>
                                    <th>Tiết học</th>
                                    <th>Lớp học phần</th>
                                    <th>Phòng</th>
                                    <th class="text-center">Sĩ số</th>
                                    <th class="text-center">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var s in Model.TodaySchedule.OrderBy(x => x.StartPeriod))
                                {
                                    <tr>
                                        <td class="align-middle text-nowrap">
                                            <strong>Tiết @s.StartPeriod - @s.EndPeriod</strong>
                                        </td>
                                        <td class="align-middle">
                                            <strong>@s.SectionCode</strong><br />
                                            <small class="text-muted">@s.CourseName</small>
                                        </td>
                                        <td class="align-middle">@s.Room</td>
                                        <td class="align-middle text-center">@s.StudentCount</td>
                                        <td class="align-middle text-center text-nowrap">
                                            <a asp-controller="Attendance" asp-action="Create" asp-route-sectionId="@s.SectionId"
                                               class="btn btn-sm btn-success">
                                                <i class="fas fa-clipboard-check mr-1"></i> Điểm danh
                                            </a>
                                            
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- CÔNG VIỆC: SẮP HẠN / QUÁ HẠN -->
        <div class="row">
            <div class="col-md-6">
                <div class="card shadow-sm card-outline card-warning">
                    <div class="card-header bg-white py-3 px-4">
                        <h5 class="font-weight-bold text-dark mb-0">
                            <i class="fas fa-hourglass-half text-warning mr-2"></i> Sắp đến hạn
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        @if (!Model.UpcomingTasks.Any())
                        {
                            <div class="text-center text-muted py-4">Không có công việc sắp đến hạn.</div>
                        }
                        else
                        {
                            <ul class="list-group list-group-flush">
                                @foreach (var t in Model.UpcomingTasks.OrderBy(x => x.DueDate))
                                {
                                    var daysLeft = (t.DueDate.Date - today).Days;
                                    <li class="list-group-item px-4">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div>
                                                <div class="font-weight-bold">
                                                    <i class="fas @(t.Type == "Attendance" ? "fa-clipboard-check" : "fa-star") text-muted mr-1"></i>
                                                    @t.Title
                                                </div>
                                                <small class="text-muted">@t.SectionCode · Hạn: @t.DueDate.ToString("dd/MM/yyyy")</small>
                                            </div>
                                            <span class="badge @(daysLeft <= 2 ? "badge-danger" : "badge-warning") ml-2 text-nowrap">
                                                @(daysLeft == 0 ? "Hôm nay" : $"Còn {daysLeft} ngày")
                                            </span>
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card shadow-sm card-outline card-danger">
                    <div class="card-header bg-white py-3 px-4">
                        <h5 class="font-weight-bold text-dark mb-0">
                            <i class="fas fa-exclamation-triangle text-danger mr-2"></i> Đã quá hạn
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        @if (!Model.OverdueTasks.Any())
                        {
                            <div class="text-center text-muted py-4">
                                <i class="fas fa-check-circle text-success mr-1"></i> Bạn không có công việc quá hạn.
                            </div>
                        }
                        else
                        {
                            <ul class="list-group list-group-flush">
                                @foreach (var t in Model.OverdueTasks.OrderBy(x => x.DueDate))
                                {
                                    var daysLate = (today - t.DueDate.Date).Days;
                                    <li class="list-group-item px-4">
                                        <div class="d-flex justify-content-between align-items-start">
                                            <div>
                                                <div class="font-weight-bold">
                                                    <i class="fas @(t.Type == "Attendance" ? "fa-clipboard-check" : "fa-star") text-muted mr-1"></i>
                                                    @t.Title
                                                </div>
                                                <small class="text-muted">@t.SectionCode · Hạn: @t.DueDate.ToString("dd/MM/yyyy")</small>
                                            </div>
                                            <span class="badge badge-danger ml-2 text-nowrap">Trễ @daysLate ngày</span>
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- ĐIỂM DANH GẦN ĐÂY -->
        <div class="card shadow-sm">
            <div class="card-header bg-white d-flex align-items-center justify-content-between py-3 px-4">
                <h5 class="font-weight-bold text-dark mb-0">
                    <i class="fas fa-clipboard-check text-success mr-2"></i> Điểm danh gần đây
                </h5>
                <a asp-controller="Attendance" asp-action="Index" class="btn btn-sm btn-outline-success">
                    Xem tất cả <i class="fas fa-arrow-right ml-1"></i>
                </a>
            </div>
            <div class="card-body px-4 py-3">
                @if (!Model.RecentAttendances.Any())
                {
                    <div class="text-center text-muted py-3">Chưa có buổi điểm danh nào.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="thead-light">
                                <tr>
                                    <th>Lớp học phần</th>
                                    <th class="text-center">Buổi</th>
                                    <th>Ngày</th>
                                    <th style="min-width: 160px;">Có mặt</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var a in Model.RecentAttendances.OrderByDescending(x => x.Date))
                                {
                                    var rate = a.Total == 0 ? 0 : (int)Math.Round(a.Present * 100.0 / a.Total);
                                    <tr>
                                        <td class="align-middle"><strong>@a.SectionCode</strong></td>
                                        <td class="align-middle text-center">@a.SessionNumber</td>
                                        <td class="align-middle">@a.Date.ToString("dd/MM/yyyy")</td>
                                        <td class="align-middle">
                                            <div class="progress" style="height: 8px;">
                                                <div class="progress-bar @(rate >= 80 ? "bg-success" : "bg-warning")" style="width: @rate%"></div>
                                            </div>
                                            <small class="text-muted">@a.Present/@a.Total (@rate%)</small>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- ================= CỘT PHẢI ================= -->
    <div class="col-lg-4">

        <!-- LỐI TẮT THEO MENU -->
        <div class="card shadow-sm">
            <div class="card-header bg-white py-3 px-4">
                <h5 class="font-weight-bold text-dark mb-0">
                    <i class="fas fa-bolt text-primary mr-2"></i> Chức năng nhanh
                </h5>
            </div>
            <div class="card-body px-4 py-3">
                <a asp-controller="Profile" asp-action="Index" class="btn btn-outline-secondary btn-block text-left">
                    <i class="fas fa-user mr-2"></i> Hồ sơ cá nhân
                </a>
                <a asp-area="Lecturer" asp-controller="Teaching" asp-action="Classes" class="btn btn-outline-info btn-block text-left">
                    <i class="fas fa-chalkboard-teacher mr-2"></i> Giảng dạy
                </a>
                <a asp-area="Lecturer" asp-controller="StudentGrade" asp-action="Sections" class="btn btn-outline-primary btn-block text-left">
                    <i class="fas fa-star mr-2"></i> Điểm số
                </a>
                <a asp-controller="Attendance" asp-action="Index" class="btn btn-outline-success btn-block text-left">
                    <i class="fas fa-clipboard-check mr-2"></i> Điểm danh
                </a>
            </div>
        </div>

        <!-- ĐIỂM SỐ: TIẾN ĐỘ NHẬP ĐIỂM -->
        <div class="card shadow-sm">
            <div class="card-header bg-white py-3 px-4">
                <h5 class="font-weight-bold text-dark mb-0">
                    <i class="fas fa-tasks text-primary mr-2"></i> Tiến độ nhập điểm
                </h5>
            </div>
            <div class="card-body px-4 py-3">
                @if (!Model.Sections.Any())
                {
                    <div class="text-center text-muted">Bạn chưa được phân công lớp học phần nào.</div>
                }
                else
                {
                    foreach (var sec in Model.Sections)
                    {
                        var percent = sec.TotalStudents == 0 ? 0 : (int)Math.Round(sec.GradedStudents * 100.0 / sec.TotalStudents);
                        var barClass = percent >= 100 ? "bg-success" : (percent >= 50 ? "bg-primary" : "bg-warning");

                        <div class="mb-3">
                            <div class="d-flex justify-content-between">
                                <div>
                                    <strong>@sec.SectionCode</strong>
                                    <small class="text-muted d-block">@sec.CourseName</small>
                                </div>
                                <div class="text-right">
                                    @if (sec.IsGradeLocked)
                                    {
                                        <span class="badge badge-danger"><i class="fas fa-lock mr-1"></i> Đã khóa</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-success"><i class="fas fa-unlock mr-1"></i> Chưa khóa</span>
                                    }
                                </div>
                            </div>
                            <div class="progress mt-1" style="height: 8px;">
                                <div class="progress-bar @barClass" style="width: @percent%"></div>
                            </div>
                            <small class="text-muted">@sec.GradedStudents/@sec.TotalStudents sinh viên đã có điểm (@percent%)</small>
                        </div>
                    }
                }
            </div>
        </div>

    </div>
</div>