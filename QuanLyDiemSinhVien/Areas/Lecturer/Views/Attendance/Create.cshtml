@model QuanLyDiemSinhVien.Models.AttendanceSessionModel

@{
    ViewData["Title"] = "Tạo buổi điểm danh";

    // Nếu chưa có ngày (giá trị mặc định 01/01/0001) thì dùng hôm nay
    var sessionDateValue = Model.SessionDate == default
        ? DateTime.Today.ToString("yyyy-MM-dd")
        : Model.SessionDate.ToString("yyyy-MM-dd");
}

<div class="container-fluid">
    <div class="card card-primary">
        <div class="card-header">
            <h3 class="card-title">
                <i class="fas fa-calendar-plus mr-2"></i>
                Tạo buổi điểm danh
            </h3>
        </div>

        <form asp-area="Lecturer"
              asp-controller="Attendance"
              asp-action="Create"
              method="post">

            <div class="card-body">
                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="form-group">
                    <label asp-for="SectionId">Lớp học phần</label>

                    <select asp-for="SectionId"
                            asp-items="ViewBag.Sections"
                            class="form-control">
                        <option value="">-- Chọn lớp học phần --</option>
                    </select>

                    <span asp-validation-for="SectionId"
                          class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label for="SessionDate">Ngày điểm danh</label>

                    <input type="date"
                           id="SessionDate"
                           name="SessionDate"
                           value="@sessionDateValue"
                           class="form-control" />

                    <span asp-validation-for="SessionDate"
                          class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Week">Tuần học</label>

                    <input asp-for="Week"
                           class="form-control"
                           placeholder="Ví dụ: Tuần 1" />

                    <span asp-validation-for="Week"
                          class="text-danger"></span>

                    <small class="form-text text-muted">
                        Nhập thống nhất cách ghi tuần, ví dụ: Tuần 1, Tuần 2.
                    </small>
                </div>

                <div class="form-group">
                    <label asp-for="Topic">Nội dung buổi học</label>

                    <input asp-for="Topic"
                           class="form-control"
                           placeholder="Nhập nội dung buổi học" />

                    <span asp-validation-for="Topic"
                          class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Note">Ghi chú</label>

                    <textarea asp-for="Note"
                              class="form-control"
                              rows="3"
                              placeholder="Ghi chú thêm nếu có"></textarea>

                    <span asp-validation-for="Note"
                          class="text-danger"></span>
                </div>
            </div>

            <div class="card-footer">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save mr-1"></i>
                    Tạo buổi điểm danh
                </button>

                <a asp-area="Lecturer"
                   asp-controller="Attendance"
                   asp-action="Index"
                   asp-route-sectionId="@Model.SectionId"
                   class="btn btn-secondary">
                    Hủy
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}