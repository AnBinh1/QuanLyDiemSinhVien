@model IEnumerable<QuanLyDiemSinhVien.Models.CourseSectionModel>

@{
    int week = ViewBag.Week ?? 1;
    string lecturerName = ViewBag.LecturerName ?? "Giảng viên";

    var days = new[]
    {
        "Thứ 2",
        "Thứ 3",
        "Thứ 4",
        "Thứ 5",
        "Thứ 6",
        "Thứ 7",
        "CN"
    };
}

<style>
    table.tkb {
        width: 100%;
        table-layout: fixed;
        border-collapse: collapse;
    }

        table.tkb th,
        table.tkb td {
            border: 1px solid #ccc;
            text-align: center;
            vertical-align: middle;
            padding: 5px;
            overflow-wrap: break-word;
        }

        table.tkb th {
            background-color: #007bff;
            color: white;
            font-weight: bold;
        }

        table.tkb td {
            height: 50px;
        }

            table.tkb td div {
                padding: 8px;
                border-radius: 6px;
                background-color: #f7e9d7;
                box-shadow: 0 1px 2px rgba(0, 0, 0, 0.1);
            }

            table.tkb td.empty {
                background-color: #f9f9f9;
            }

    .week-btns .btn {
        margin: 2px;
    }
</style>


<div class="card card-outline card-primary shadow-sm mb-4">
    <div class="card-body py-3 text-center">

        <h3 class="font-weight-bold text-primary mb-2">
            <i class="fas fa-calendar-alt mr-2"></i>
            Thời khóa biểu
        </h3>

        <div class="text-muted">
            <i class="fas fa-calendar-week mr-1"></i>
            Lịch giảng dạy
            <span class="badge badge-primary ml-2 px-3 py-2">
                Tuần @week
            </span>
        </div>

    </div>
</div>




<table class="tkb">

    <thead>
        <tr>

            <th style="width: 8%;">
                Tiết
            </th>

            @foreach (var day in days)
            {
                <th>
                    @day
                </th>
            }

        </tr>
    </thead>

    <tbody>

        @for (int period = 1; period <= 10; period++)
        {
            <tr>

                <td>
                    <strong>@period</strong>
                </td>

                @for (int day = 2; day <= 8; day++)
                {
                    var classAtSlot = Model.FirstOrDefault(cs =>
                    cs.DayOfWeek == day &&
                    cs.StartPeriod <= period &&
                    cs.EndPeriod >= period
                    );

                    if (classAtSlot != null &&
                    classAtSlot.StartPeriod == period)
                    {
                        int? rowspan = classAtSlot.EndPeriod
                        - classAtSlot.StartPeriod
                        + 1;

                        <td rowspan="@rowspan">

                            <div>

                                <strong>
                                    @(classAtSlot.Course?.CourseName
                                                            ?? "Chưa có tên học phần")
                                                                                  </strong>

                                <br />

                                <span>
                                    LHP: @classAtSlot.SectionCode
                                </span>

                                <br />

                                <span>
                                    Phòng:
                                    <b>
                                        @(string.IsNullOrEmpty(classAtSlot.Room)
                                                                    ? "Chưa xếp phòng"
                                                                    : classAtSlot.Room)
                        </b>
                    </span>

                                <br />

                                <small>
                                    Tiết:
                                    @classAtSlot.StartPeriod
                                    -
                                    @classAtSlot.EndPeriod
                                </small>

                                <br />

                                <small>
                                    Sinh viên:
                                    @classAtSlot.RegisteredStudents
                                </small>

                            </div>

                        </td>
                        }
                    else if (Model.Any(cs =>
                    cs.DayOfWeek == day &&
                    cs.StartPeriod < period &&
                    cs.EndPeriod >= period))
                    {
                        @* Ô này thuộc rowspan của tiết phía trên *@
                    }
                    else
                    {
                        <td class="empty"></td>
                    }
                }

            </tr>
        }

    </tbody>

</table>

<div class="text-center mb-3 mt-4 week-btns">

    <span class="mr-2 font-weight-bold">
        Chọn tuần:
    </span>

    @for (int w = 1; w <= 21; w++)
    {
        <a asp-area="Lecturer"
           asp-controller="Timetable"
           asp-action="Index"
           asp-route-week="@w"
           class="btn btn-sm @(w == week
                           ? "btn-primary"
                           : "btn-outline-primary")">
        @w
    </a>
        }

</div>