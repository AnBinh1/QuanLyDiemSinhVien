@*
    =========================================================
    CHATBOT WIDGET - TRỢ LÝ ẢO ĐẠI HỌC VINH
    File: Views/Shared/_ChatbotWidget.cshtml

    Chức năng:
    - Hiển thị giao diện chatbot
    - Kết nối file CSS và JavaScript riêng
    - Sử dụng Marked.js và DOMPurify
    =========================================================
*@

<link rel="stylesheet"
      href="~/css/chatbot.css"
      asp-append-version="true" />

<div class="vinh-chatbot" id="vinh-chatbot">
    <button type="button"
            class="vinh-chatbot-btn"
            aria-label="Mở trợ lý ảo"
            aria-expanded="false">

        <i class="bi bi-chat-dots-fill"></i>
        <i class="bi bi-x-lg"></i>

        <span class="vinh-chatbot-badge">1</span>
    </button>

    <div class="vinh-chatbot-panel">

        <div class="vinh-chatbot-header">

            <div class="avatar">
                <i class="bi bi-mortarboard-fill"></i>
            </div>

            <div class="info">
                <strong>Trợ lý ảo Đại học Vinh</strong>
                <span>Đang hoạt động</span>
            </div>

        </div>

        <div class="vinh-chatbot-body" aria-live="polite">

            <div class="vinh-chatbot-message vinh-chatbot-assistant">

                <div class="vinh-chatbot-message-content">
                    Chào bạn! Mình là trợ lý ảo Đại học Vinh.
                    Mình có thể giúp gì cho bạn hôm nay?
                </div>

            </div>

        </div>

        <div class="vinh-chatbot-input">

            <input type="text"
                   placeholder="Nhập câu hỏi của bạn..."
                   autocomplete="off"
                   maxlength="2000"
                   aria-label="Nhập câu hỏi" />

            <button type="button" aria-label="Gửi câu hỏi">
                <i class="bi bi-send-fill"></i>
            </button>

        </div>

    </div>
</div>

<!-- THƯ VIỆN MARKDOWN -->
<script src="https://cdn.jsdelivr.net/npm/marked@15.0.7/marked.min.js"
        defer></script>

<!-- THƯ VIỆN LÀM SẠCH HTML -->
<script src="https://cdn.jsdelivr.net/npm/dompurify@3.2.6/dist/purify.min.js"
        defer></script>

<script src="~/js/chatbot.js"
        asp-append-version="true"
        defer></script>
