<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Trường Đại học Vinh</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/chatbot-widget.css" asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/home.css"
          asp-append-version="true" />
</head>
<body class="university-homepage">

   <div>
        @RenderBody()
   </div>

    <partial name="_ChatbotWidget" />

    <script src="~/js/chatbot-widget.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <!-- =========================
         FOOTER
    ========================= -->
    <footer class="footer">

        <div class="container footer-grid">

            <div class="footer-brand">

                <div class="brand-logo">
                    <span>V</span>
                </div>

                <h3>
                    TRƯỜNG ĐẠI HỌC VINH
                </h3>

                <p>
                    VINH UNIVERSITY
                </p>

                <div class="socials">

                    <a href="#">
                        <i class="bi bi-facebook"></i>
                    </a>

                    <a href="#">
                        <i class="bi bi-youtube"></i>
                    </a>

                    <a href="#">
                        <i class="bi bi-envelope"></i>
                    </a>

                </div>

            </div>


            <div class="footer-column">

                <h4>Liên kết</h4>

                <a href="#">Trang chủ</a>
                <a href="#">Giới thiệu</a>
                <a href="#">Đào tạo</a>
                <a href="#">Tuyển sinh</a>
                <a href="#">Khoa học - Công nghệ</a>

            </div>


            <div class="footer-column">

                <h4>Hệ thống</h4>

                <a href="#">Cổng sinh viên</a>
                <a href="#">Cổng giảng viên</a>
                <a href="#">Quản trị hệ thống</a>
                <a href="#">E-Learning</a>
                <a href="#">Thư viện số</a>

            </div>


            <div class="footer-column">

                <h4>Liên hệ</h4>

                <p>
                    <i class="bi bi-geo-alt"></i>
                    182 Lê Duẩn, Nghệ An
                </p>

                <p>
                    <i class="bi bi-telephone"></i>
                    (0238) 3855 452
                </p>

                <p>
                    <i class="bi bi-envelope"></i>
                    info@vinhuni.edu.vn
                </p>

            </div>

        </div>


        <div class="footer-bottom">

            <div class="container">

                <span>
                    © 2026 Trường Đại học Vinh.
                    All rights reserved.
                </span>

                <span>
                    Hệ thống quản lý trường đại học
                </span>

            </div>

        </div>

    </footer>

</body>
</html>
@await RenderSectionAsync("Scripts", required: false)